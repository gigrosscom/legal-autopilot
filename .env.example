# ---- API ----
DATABASE_URL=postgresql+psycopg://konsilier:konsilier@postgres:5432/konsilier
PACKS_DIR=/app/packs
# local | s3
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=/app/data/files
S3_ENDPOINT_URL=http://s3:8333
S3_BUCKET=konsilier
S3_ACCESS_KEY=konsilier
S3_SECRET_KEY=konsilier-secret
# LLM: anthropic | mock
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# Server-side refusal fallback for the Anthropic provider ("default" or empty to disable)
LLM_REFUSAL_FALLBACK=default
# Images can't be PII-redacted before the LLM sees them; enable only with user consent
EXTRACT_IMAGES_WITH_LLM=false
# Qualification threshold: below it the case is flagged needs_review
QUALIFY_MIN_CONFIDENCE=0.6
# First N cases of each scenario need lawyer approval before the document is released
APPROVAL_REQUIRED_FIRST_N=50
ADMIN_TOKEN=change-me-admin
# Shared secret the Telegram bot uses to act on behalf of Telegram users
BOT_API_SECRET=change-me-bot
# PDF conversion (LibreOffice). Leave empty to skip PDF.
SOFFICE_BIN=soffice
# Scheduler tick interval (seconds); 0 disables the in-process scheduler
SCHEDULER_INTERVAL_SECONDS=60
# SMTP for SubmissionAdapter "email" (Mailpit in docker compose)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@konsilier.com
CORS_ORIGINS=http://localhost:3000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=konsilier_bot
API_URL=http://api:8000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT=konsilier_bot
