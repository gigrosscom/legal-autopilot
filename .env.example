# ---- API ----
DATABASE_URL=postgresql+psycopg://konsilier:konsilier@postgres:5432/konsilier
PACKS_DIR=/app/packs
# local | s3
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=/app/data/files
S3_ENDPOINT_URL=http://s3:8333
S3_BUCKET=konsilier
S3_ACCESS_KEY=konsilier
S3_SECRET_KEY=konsilier-secret
# LLM: anthropic | mock
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5
# Free consultation chat: gemini (Google AI Studio free tier; key from aistudio.google.com) or anthropic (paid)
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CHAT_DAILY_LIMIT=40  # messages per person per day
ANTHROPIC_API_KEY=
# Server-side refusal fallback for the Anthropic provider ("default" or empty to disable)
LLM_REFUSAL_FALLBACK=default
# Images can't be PII-redacted before the LLM sees them; enable only with user consent
EXTRACT_IMAGES_WITH_LLM=false
# Qualification threshold: below it the case is flagged needs_review
QUALIFY_MIN_CONFIDENCE=0.6
# First N cases of each scenario need lawyer approval before the document is released
APPROVAL_REQUIRED_FIRST_N=50
ADMIN_TOKEN=change-me-admin
# Shared secret the Telegram bot uses to act on behalf of Telegram users
BOT_API_SECRET=change-me-bot
# PDF conversion (LibreOffice). Leave empty to skip PDF.
SOFFICE_BIN=soffice
# Scheduler tick interval (seconds); 0 disables the in-process scheduler
SCHEDULER_INTERVAL_SECONDS=60
# SMTP for SubmissionAdapter "email" (Mailpit in docker compose)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@konsilier.com
CORS_ORIGINS=http://localhost:3000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KonsilierAI_bot
API_URL=http://api:8000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT=KonsilierAI_bot

# Sign-in (apps/api/konsilier/identity). Methods stay off until configured; see GET /v1/auth/methods.
IDENTITY_SECRET=change-me-identity        # random, stable: keys the hashes of e-mails, phones and IINs
PUBLIC_API_URL=http://localhost:8000      # eGov Mobile fetches the document to sign from here
RESEND_API_KEY=                           # e-mail codes (or SMTP_HOST above)
EMAIL_FROM=Konsilier.AI <no-reply@konsilier.com>
SMS_PROVIDER=                             # mobizon | smsc
SMS_API_KEY=                              # Mobizon
SMSC_LOGIN=
SMSC_PASSWORD=
SMS_SENDER=                               # registered sender name, if any
NCANODE_URL=                              # e.g. http://ncanode:14579 — enables ЭЦП (NCALayer)
EGOV_ORG_BIN=                             # company BIN shown in eGov Mobile; enables eGov Mobile QR sign-in
