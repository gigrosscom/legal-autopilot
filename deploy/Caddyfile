(security) {
	# QA BUG-06: HTTPS only for a year, no MIME sniffing, no framing by other sites (clickjacking on the payment
	# button), a referrer without paths, and no server banners. Scripts are not restricted here: the site relies
	# on Next.js inline scripts and NCALayer (wss://127.0.0.1) — a script CSP would break sign-in with ЭЦП.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-X-Powered-By
		-Server
	}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	import security
	encode zstd gzip
	# Hashed build assets never change — cache them forever.
	@static path /_next/static/*
	handle @static {
		reverse_proxy web:3000
	}
	# Pages: always revalidate, so phones never show an outdated version after a deploy.
	handle {
		reverse_proxy web:3000 {
			header_down Cache-Control "no-cache"
		}
	}
}

{$API_DOMAIN} {
	import security
	encode zstd gzip
	# Two copies of the API (docker-compose.prod.yml: api, api2), restarted one at a time by update.sh. `first`: every
	# request goes to `api` while it is healthy (one process, as before: its warm chat connections and in-memory
	# limits), to `api2` while `api` restarts. A copy that is stopping refuses new connections at once; Caddy then
	# tries the other one for up to lb_try_duration. Answers already streaming finish on the old copy.
	reverse_proxy api:8000 api2:8000 {
		lb_policy first
		lb_try_duration 15s
		lb_try_interval 250ms
		fail_duration 10s
		health_uri /health
		health_interval 3s
		health_timeout 3s
		health_passes 1
		health_fails 2
		# server-sent events (the chat answer) go to the person chunk by chunk
		flush_interval -1
	}
}
