# /opt/konsilier/.env on the server. Never commit the real file.
SITE_DOMAIN=konsilier.com
API_DOMAIN=api.konsilier.com

# Managed PostgreSQL (Yandex Cloud: host from the cluster page, port 6432, SSL required)
DATABASE_URL=postgresql+psycopg://konsilier:PASSWORD@HOST:6432/konsilier?sslmode=require
# or a database on the same server: COMPOSE_PROFILES=localdb + LOCAL_DB_PASSWORD=...
#COMPOSE_PROFILES=localdb
#LOCAL_DB_PASSWORD=
#DATABASE_URL=postgresql+psycopg://konsilier:SAME_PASSWORD@postgres:5432/konsilier

# Object Storage (documents, uploads, backups)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://storage.yandexcloud.kz
S3_REGION=kz1
S3_BUCKET=konsilier-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

LLM_PROVIDER=anthropic
EXPERIMENTAL_SCENARIOS=false            # beta scenarios (tender, admission, visa, ИП, business): keep off in production
LLM_MODEL=claude-sonnet-5        # writes document text
LLM_FAST_MODEL=claude-haiku-4-5  # classification, field extraction, reading receipts
# LLM_PROVIDER=gemini runs the whole backend (classification, documents) on the free Gemini key too
# Free consultation chat: gemini (Google AI Studio free tier; key from aistudio.google.com) or anthropic (paid)
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# When it is overloaded: these free models in turn (the chat never falls back to a paid model)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview
# CHAT_PROVIDER=free: these free providers in turn, each until it answers (no key → skipped).
# Keys: console.groq.com, cloud.cerebras.ai, build.nvidia.com (also: mistral, openrouter). Empty *_MODEL → default.
CHAT_FREE_PROVIDERS=gemini,cerebras,groq,nvidia
CEREBRAS_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# Paid Claude answer when every free model fails (off by default)
CHAT_FALLBACK_TO_ANTHROPIC=false
# Claude fallback stops for the rest of the UTC day once the estimated cost of its chat replies reaches this (0 = off)
CHAT_FALLBACK_DAILY_BUDGET_USD=10
CHAT_DAILY_LIMIT=40  # messages per person per day
ANTHROPIC_API_KEY=
# Claude via Amazon Bedrock instead (paid from AWS credits, e.g. AWS Activate): set LLM_PROVIDER=bedrock.
# Same model names; the "anthropic." prefix is added automatically. Enable the models in the Bedrock console first.
BEDROCK_REGION=eu-central-1
BEDROCK_ACCESS_KEY=
BEDROCK_SECRET_KEY=

ADMIN_TOKEN=
BOT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=           # set together with TELEGRAM_BOT_TOKEN; empty hides the Telegram button
APPROVAL_REQUIRED_FIRST_N=50
SCHEDULER_INTERVAL_SECONDS=60

# Document payment. manual_transfer: the client transfers to the Kaspi number below and writes the payment code in
# the comment; the clients desk (OPS_CLIENTS_EMAILS) confirms it in /ops. While the recipient or the number is empty,
# documents are not issued ("payment temporarily unavailable"). stub — every invoice paid at once (tests/dev only).
PAYMENT_MODE=manual_transfer
PAYMENT_RECIPIENT_NAME=          # recipient's name as the payer's banking app shows it
PAYMENT_KASPI_PHONE=             # Kaspi number to transfer to (Kaspi Gold now, the company account later)
PAYMENT_COMMENT_PREFIX=          # optional prefix of the payment code, e.g. KA
PAYMENT_NOTIFY_EMAILS=           # also get «клиент оплатил» letters (no access to /ops)
