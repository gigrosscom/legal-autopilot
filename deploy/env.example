# /opt/konsilier/.env on the server. Never commit the real file.
SITE_DOMAIN=konsilier.com
API_DOMAIN=api.konsilier.com

# Managed PostgreSQL (Yandex Cloud: host from the cluster page, port 6432, SSL required)
DATABASE_URL=postgresql+psycopg://konsilier:PASSWORD@HOST:6432/konsilier?sslmode=require
# or a database on the same server: COMPOSE_PROFILES=localdb + LOCAL_DB_PASSWORD=...
#COMPOSE_PROFILES=localdb
#LOCAL_DB_PASSWORD=
#DATABASE_URL=postgresql+psycopg://konsilier:SAME_PASSWORD@postgres:5432/konsilier

# Object Storage (documents, uploads, backups)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://storage.yandexcloud.kz
S3_REGION=kz1
S3_BUCKET=konsilier-files
S3_ACCESS_KEY=
S3_SECRET_KEY=

LLM_PROVIDER=anthropic
EXPERIMENTAL_SCENARIOS=true             # beta scenarios marked «Бета» (owner 30.09: the 12 legal ones on)
BETA_SCENARIOS_OFF=kz.services.university_admission,kz.services.study_abroad,kz.services.visa_schengen_de,kz.services.visa_uk,kz.services.visa_us  # kept off: study and visas
LLM_MODEL=claude-sonnet-5        # writes document text
LLM_FAST_MODEL=claude-haiku-4-5  # classification, field extraction, reading receipts
# LLM_PROVIDER=gemini runs the whole backend (classification, documents) on the free Gemini key too
# Free consultation chat: gemini (Google AI Studio free tier; key from aistudio.google.com) or anthropic (paid)
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# When it is overloaded: these free models in turn (the chat never falls back to a paid model)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview
# CHAT_PROVIDER=free: these free providers in turn, each until it answers (no key → skipped).
# Keys: console.groq.com, cloud.cerebras.ai, build.nvidia.com (also: mistral, openrouter). Empty *_MODEL → default.
CHAT_FREE_PROVIDERS=cerebras,gemini,groq
# Chat speed (owner 30.09: first words within 2 s). A provider silent this long gets the next one asked in parallel
# (0 = only after a failure); Gemini 3 thinks least before writing (empty = the model's default); articles are cut
# from the Zann corpus copy when it has the act (else adilet live).
CHAT_FIRST_TOKEN_TIMEOUT=1.5
GEMINI_CHAT_THINKING_LEVEL=minimal
# GEMINI_MODEL silent this long → the GEMINI_FALLBACK_MODELS are asked in parallel, the first to answer is used
# (0 = only after a failure). Keep it below CHAT_FIRST_TOKEN_TIMEOUT.
GEMINI_HEDGE_AFTER=0.5
LAW_TEXTS_LOCAL=true
CEREBRAS_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# Paid Claude answer when every free model fails (off by default)
CHAT_FALLBACK_TO_ANTHROPIC=false
# Claude fallback stops for the rest of the UTC day once the estimated cost of its chat replies reaches this (0 = off)
CHAT_FALLBACK_DAILY_BUDGET_USD=10
CHAT_DAILY_LIMIT=40  # messages per person per day
# Library of official pages for the chat (docs/official-library.md): refreshed every night at 03:00 pack local time,
# at most 20 minutes; the chat searches the stored pages. First fill right after deploy:
#   python -m konsilier.cli official-crawl KZ --minutes 20
OFFICIAL_CRAWL_ENABLED=true
OFFICIAL_CRAWL_HOUR=3
OFFICIAL_CRAWL_MINUTES=20
OFFICIAL_CRAWL_MAX_PAGES=400  # per domain
# Zann law corpus (docs/zann-llm-plan.md, раздел 4а): every act of old.adilet.zan.kz in force, ru + kk, gzip texts in
# the storage under zann/corpus/ (+ manifest.jsonl.gz). No LLM calls. Off by default.
#   ZANN_CORPUS_HOUR: local (KZ) hour of the nightly run, 2 → 02:00–02:50, before the 03:00 crawl above;
#                     -1 → continuous: time-boxed runs back to back around the clock (the first fill takes days).
#   Order: codes and constitutional acts → laws → decrees/resolutions/orders → everything else in force.
#   Progress: /v1/admin/metrics → "zann". By hand: python -m konsilier.cli zann-corpus [--limit N] [--discover]
ZANN_CORPUS_ENABLED=false
ZANN_CORPUS_HOUR=2
ZANN_CORPUS_MINUTES=50        # length of one run
ZANN_CORPUS_PAUSE=3           # seconds between requests to adilet (min 2)
ZANN_CORPUS_LANGS=ru,kk
ZANN_CORPUS_STATUSES=in_force # in_force,lost — also acts that lost force (≈98k), after all acts in force
ZANN_CORPUS_REFRESH_DAYS=30   # re-walk the index and re-read texts older than this; unchanged texts are not re-uploaded
ZANN_CORPUS_TZ=Asia/Almaty    # time zone of ZANN_CORPUS_HOUR
# Zann search («ищет и цитирует», docs/zann-llm-plan.md §4б): the collected acts split into articles (zann_articles),
# refreshed incrementally (only new / changed files by sha256) every ZANN_INDEX_EVERY_MINUTES and after each corpus
# run, at most ZANN_INDEX_MINUTES per run. GET /v1/zann/search (admin token or bot secret); the chat gets the best
# articles and a law_search tool (ZANN_SEARCH_CHAT). Free: PostgreSQL full text, no LLM.
ZANN_INDEX_ENABLED=true
ZANN_INDEX_EVERY_MINUTES=30
ZANN_INDEX_MINUTES=10
ZANN_SEARCH_CHAT=true
# off | e5-small — semantic search with intfloat/multilingual-e5-small (MIT) on the server CPU; needs
# `pip install sentence-transformers` in the API image (≈ +700 MB with CPU torch). Off by default.
ZANN_EMBEDDINGS=off
ANTHROPIC_API_KEY=
# Claude via Amazon Bedrock instead (paid from AWS credits, e.g. AWS Activate): set LLM_PROVIDER=bedrock.
# Same model names; the "anthropic." prefix is added automatically. Enable the models in the Bedrock console first.
BEDROCK_REGION=eu-central-1
BEDROCK_ACCESS_KEY=
BEDROCK_SECRET_KEY=

# ADMIN_TOKEN opens /admin and the command centre app /ops (docs/command-center.md)
ADMIN_TOKEN=
# Command centre (/ops): the team's files (team/sessions.md, decisions.md, backlog.md, reports/…) are read from the
# git branch below on GitHub and cached TEAM_CACHE_SECONDS. TEAM_GITHUB_TOKEN: only if the repository is private —
# a fine-grained read-only token (Contents: read) for this one repository. TEAM_DIR: read from a local folder
# instead (a checkout of the branch; the folder that contains team/) — GitHub is then not used.
TEAM_GITHUB_REPO=gigrosscom/legal-autopilot
TEAM_GITHUB_REF=claude/ai-team
TEAM_GITHUB_TOKEN=
TEAM_DIR=
TEAM_CACHE_SECONDS=300
BOT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=           # set together with TELEGRAM_BOT_TOKEN; empty hides the Telegram button

# Web push (notifications on phones and computers, the installed app included). Print a pair once with
# `python deploy/vapid_keys.py`; empty → push is off. Changing the pair later drops every subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@konsilier.com
# «Войти через Google» / «Войти через Apple» (docs/auth-google-apple.md). Public ids, not secrets; empty → the
# button is hidden. APPLE_REDIRECT_URI: empty → https://SITE/account (PUBLIC_SITE_URL/account).
GOOGLE_CLIENT_ID=
APPLE_SERVICES_ID=
APPLE_REDIRECT_URI=
# Google Play app (Trusted Web Activity, docs/app-stores.md): SHA-256 fingerprint(s) of the app signing key
# (Play Console → App integrity), comma-separated; served at https://SITE_DOMAIN/.well-known/assetlinks.json
ANDROID_PACKAGE=com.konsilier.app
ANDROID_CERT_SHA256=
APPROVAL_REQUIRED_FIRST_N=50
SCHEDULER_INTERVAL_SECONDS=60

# Document payment. manual_transfer: the client transfers to the Kaspi number below and writes the payment code in
# the comment; the clients desk (OPS_CLIENTS_EMAILS) confirms it in /ops. While the recipient or the number is empty,
# documents are not issued ("payment temporarily unavailable"). stub — every invoice paid at once (tests/dev only).
PAYMENT_MODE=manual_transfer
PAYMENT_RECIPIENT_NAME=          # recipient's name as the payer's banking app shows it
PAYMENT_KASPI_PHONE=             # Kaspi number to transfer to (Kaspi Gold now, the company account later)
PAYMENT_COMMENT_PREFIX=          # optional prefix of the payment code, e.g. KA
PAYMENT_NOTIFY_EMAILS=           # also get «клиент оплатил» letters (no access to /ops)
# More ways to pay (docs/kaspi-pay-plan.md), all confirmed in /ops like the transfer. Off while empty. Comma-separated:
# kaspi_link, kaspi_qr, kaspi_invoice, bank_invoice. A way shows only once what it needs below is filled in.
PAYMENT_METHODS=
PAYMENT_KASPI_PAY_LINK=          # Kaspi Pay app → Удалённая оплата → Ссылка для оплаты (https://…)
PAYMENT_KASPI_QR_IMAGE=          # URL of the printed Kaspi QR image of the point of sale
# «Счёт на оплату» for companies / ИП (bank_invoice): the company's requisites
PAYMENT_LLP_NAME=
PAYMENT_LLP_BIN=
PAYMENT_LLP_ADDRESS=
PAYMENT_LLP_BANK=
PAYMENT_LLP_IIK=                 # IBAN KZ…
PAYMENT_LLP_BIK=
PAYMENT_LLP_KBE=17
PAYMENT_LLP_KNP=859
PAYMENT_LLP_DIRECTOR=
PAYMENT_LLP_VAT=false            # true only for a VAT payer
PAYMENT_INVOICE_DUE_DAYS=5
PAYMENT_RECEIPT_EMAIL=false      # letter after confirmation: amount, date, item, link (not a fiscal receipt)
PAYMENT_KASPI_KASSA=false        # true once Kaspi Касса is on in the Kaspi Pay app (Kaspi sends the fiscal receipt)
PAYMENT_KASPI_WEBHOOK=false      # automatic confirmation — only after Kaspi's protocol under a contract
PAYMENT_KASPI_WEBHOOK_SECRET=
# Plans: one document = the scenario price; «Дело под ключ» = every document of one case; «Бизнес» / «Бизнес Про» =
# 30-day subscriptions with a document limit, paid by the same transfer and confirmed in /ops.
PLAN_CASE_PRICE=9990
PLAN_BIZ_PRICE=29990
PLAN_BIZ_DOCUMENTS=20
PLAN_BIZPRO_PRICE=59990
PLAN_BIZPRO_DOCUMENTS=60
PLAN_PERIOD_DAYS=30
PLAN_CURRENCY=KZT
